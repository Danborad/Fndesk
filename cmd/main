#!/bin/bash

# ========== Fndesk Lite 进程守护与生命周期管理 ==========
TRIM_APPNAME="${TRIM_APPNAME:-fndesk}"
TRIM_APPDEST_VOL="${TRIM_APPDEST_VOL:-/vol1}"
TRIM_APPDEST="${TRIM_APPDEST:-/var/apps/fndesk/target}"
TRIM_PKGVAR="${TRIM_PKGVAR:-/var/apps/fndesk/var}"

LOG_FILE="${TRIM_APPDEST_VOL}/@appshare/${TRIM_APPNAME}/fndesk日志.log"
PID_FILE="${TRIM_PKGVAR}/app.pid"
SERVER_JS="${TRIM_APPDEST}/server/server.js"

mkdir -p "$(dirname "${LOG_FILE}")" 2>/dev/null || true
touch "${LOG_FILE}" 2>/dev/null || true
exec >> "${LOG_FILE}" 2>&1

trim_log() {
    if [ -f "${LOG_FILE}" ]; then
        local line_count=$(wc -l < "${LOG_FILE}")
        if [ "${line_count}" -gt 200 ]; then
            sed -i -e :a -e '$q;N;101,$D;ba' "${LOG_FILE}"
            echo "$(date '+%Y-%m-%d %H:%M:%S') - [Fndesk Lite] 日志已裁剪，保留最后100行"
        fi
    fi
}

find_node() {
    for p in "/usr/bin/node" "/usr/local/bin/node" "/var/apps/nodejs_v22/target/bin/node" "/var/apps/nodejs_v24/target/bin/node"; do
        if [ -x "$p" ]; then
            echo "$p"
            return 0
        fi
    done
    if command -v node >/dev/null 2>&1; then
        command -v node
        return 0
    fi
    return 1
}

check_process() {
    local pid=$1
    [ -n "${pid}" ] && kill -0 "${pid}" 2>/dev/null && return 0 || return 1
}

status() {
    if [ -f "${PID_FILE}" ]; then
        pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')
        if check_process "${pid}"; then
            return 0
        else
            rm -f "${PID_FILE}"
        fi    
    fi
    return 1
}

stop_process() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - [Fndesk Lite] 正在停止服务..."
    if [ -r "${PID_FILE}" ]; then
        pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')
        if check_process "${pid}"; then
            kill -TERM "${pid}" 2>/dev/null || true
            local count=0
            while check_process "${pid}" && [ $count -lt 5 ]; do
                sleep 1
                count=$((count + 1))
            done
            if check_process "${pid}"; then
                kill -KILL "${pid}" 2>/dev/null || true
            fi
        fi
        rm -f "${PID_FILE}"
    fi
    pkill -f "${SERVER_JS}" 2>/dev/null || true
    echo "$(date '+%Y-%m-%d %H:%M:%S') - [Fndesk Lite] 服务已停止"
    return 0
}

start_process() {
    echo "-------------- [$(date '+%Y-%m-%d %H:%M:%S')] --------------"
    echo "$(date '+%Y-%m-%d %H:%M:%S') - [Fndesk Lite] 启动中..."
    
    if status; then
        echo "$(date '+%Y-%m-%d %H:%M:%S') - [Fndesk Lite] 进程已在运行"
        return 0
    fi

    NODE_BIN=$(find_node)
    if [ -z "${NODE_BIN}" ]; then
        echo "$(date '+%Y-%m-%d %H:%M:%S') - 错误：系统中未找到 Node.js 运行时！"
        return 1
    fi

    echo "$(date '+%Y-%m-%d %H:%M:%S') - 使用 Node: ${NODE_BIN}，执行脚本: ${SERVER_JS}"
    nohup "${NODE_BIN}" "${SERVER_JS}" >> "${LOG_FILE}" 2>&1 &
    local app_pid=$!
    printf "%s" "${app_pid}" > "${PID_FILE}"
    echo "$(date '+%Y-%m-%d %H:%M:%S') - [Fndesk Lite] 服务启动成功，PID: ${app_pid}"
    return 0
}

case $1 in
start)
    start_process
    ;;
stop)
    stop_process
    trim_log
    ;;
status)
    status
    exit $?
    ;;
restart)
    stop_process
    sleep 1
    start_process
    ;;
*)
    exit 1
    ;;
esac
